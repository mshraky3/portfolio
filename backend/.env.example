# Copy to .env and fill in. Never commit the real .env.

# --- Contact form / outbound email (Gmail SMTP) ---
# EMAIL_PASS must be a 16-character Gmail App Password, not your account password.
# App Passwords require 2-Step Verification to be enabled on the account.
EMAIL_USER=you@gmail.com
EMAIL_PASS=xxxxxxxxxxxxxxxx

# --- CORS ---
# Origin allowed to call this API. Defaults to the deployed site if unset.
ALLOWED_ORIGIN=http://localhost:5173

# --- Scheduled job routes (/job-digest, /evening-checkin) ---
# Requests must authenticate with either:
#   Authorization: Bearer <CRON_SECRET>   (used by Vercel Cron)
#   ?key=<DIGEST_SECRET>                  (used by an external cron service)
CRON_SECRET=
DIGEST_SECRET=
